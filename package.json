{
  "name": "assorted-tools",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "tsc -p tsconfig.json --noEmit && eslint . --max-warnings 0 && knip",
    "test": "vitest --run",
    "test-coverage": "vitest --run --coverage",
    "format": "prettier --write .",
    "format-check": "prettier --check ."
  },
  "dependencies": {
    "@dan-schel/js-utils": "4.14.1",
    "clsx": "2.1.1",
    "preact": "10.29.8",
    "preact-iso": "2.12.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "knip": "6.41.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
